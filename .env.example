# OpenAI embeddings
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Similarity / report save options
SIMILARITY_JSON_PATH=outputs/similarity_results.json
GOOGLE_SHEETS_WEBHOOK_URL=
REPORT_XLSX_PATH=outputs/consulting_report.xlsx

# Next.js front-end base URL for API requests (optional)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-only value example
API_SECRET_KEY=change-me
